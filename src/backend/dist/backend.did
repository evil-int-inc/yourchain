type VideoStatus = 
 variant {
   deleted;
   draft;
   processing;
   published;
 };
type Video = 
 record {
   createdAt: Timestamp;
   description: opt text;
   fileSize: nat;
   id: nat;
   mimeType: text;
   ownerId: UserId;
   publishedAt: opt Timestamp;
   status: VideoStatus;
   thumbnailAssetId: opt text;
   title: text;
   videoAssetId: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserId = principal;
type User = 
 record {
   avatar: opt text;
   bio: opt text;
   createdAt: Timestamp;
   displayName: text;
   id: UserId;
   username: text;
 };
type UploadStatus = 
 variant {
   active;
   cancelled;
   completed;
   finalized;
 };
type UploadSession = 
 record {
   assetId: text;
   chunkSize: nat;
   createdAt: Timestamp;
   id: nat;
   kind: UploadKind;
   mimeType: text;
   ownerId: UserId;
   receivedBytes: nat;
   status: UploadStatus;
   totalSize: nat;
 };
type UploadKind = 
 variant {
   thumbnail;
   video;
 };
type Timestamp = int;
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Page_1 = 
 record {
   items: vec Notification;
   nextCursor: opt Cursor;
 };
type Page = 
 record {
   items: vec Video;
   nextCursor: opt Cursor;
 };
type NotificationKind = 
 variant {
   newSubscriber: record {channelId: UserId;};
   newVideo: record {
               channelId: UserId;
               videoId: nat;
             };
 };
type Notification = 
 record {
   createdAt: Timestamp;
   id: nat;
   kind: NotificationKind;
   read: bool;
   recipientId: UserId;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cursor = nat;
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createUploadSession: (kind: UploadKind, totalSize: nat, mimeType: text) ->
   (UploadSession);
  deleteVideo: (videoId: nat) -> ();
  execute: (qJson: text) -> (Result) query;
  finalizeMedia: (sessionId: nat, title: text, description: opt text,
   thumbnailAssetId: opt text) -> (Video);
  getApiDoc: () -> (text) query;
  getCallerProfile: () -> (opt User) query;
  getCallerUserRole: () -> (UserRole) query;
  getChannel: (userId: UserId) -> (opt User) query;
  getChannelByUsername: (username: text) -> (opt User) query;
  getChannelVideos: (userId: UserId, cursor: Cursor, limit: nat) ->
   (Page) query;
  getFeed: (cursor: Cursor, limit: nat) -> (Page) query;
  getMyVideos: (cursor: Cursor, limit: nat) -> (Page) query;
  getNotifications: (cursor: Cursor, limit: nat) -> (Page_1) query;
  getStorageProviders: () -> (vec text) query;
  getSubscribedChannels: () -> (vec UserId) query;
  getSubscriberCount: (channelId: UserId) -> (nat) query;
  getSubscriptionFeed: (cursor: Cursor, limit: nat) -> (Page) query;
  getUnreadNotificationCount: () -> (nat) query;
  getVideo: (videoId: nat) -> (opt Video) query;
  isCallerAdmin: () -> (bool) query;
  isSubscribed: (channelId: UserId) -> (bool) query;
  markNotificationsRead: () -> ();
  publishVideo: (videoId: nat) -> (Video);
  registerStorageProvider: (providerId: text) -> ();
  saveProfile: (displayName: text, username: text, avatar: opt text, bio:
   opt text) -> (User);
  schema: () -> (text) query;
  subscribe: (channelId: UserId) -> ();
  unsubscribe: (channelId: UserId) -> ();
  uploadChunk: (sessionId: nat, chunkIndex: nat, data: blob) -> (nat);
  verifyUpload: (sessionId: nat) -> ();
}
